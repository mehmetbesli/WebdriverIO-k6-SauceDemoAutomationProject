{
  "name": "webdriverio-k6-saucedemo-automation-project",
  "version": "1.0.0",
  "description": "Enterprise End-to-End Test Automation with WebdriverIO (TypeScript) and Performance Testing with k6 (JavaScript) for SauceDemo",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:e2e",
    "test:all": "npm run test:e2e && npm run test:perf",
    "test:e2e": "wdio run ./src/config/wdio.conf.ts",
    "test:e2e:headed": "cross-env HEADLESS=false wdio run ./src/config/wdio.conf.ts",
    "test:e2e:spec": "wdio run ./src/config/wdio.conf.ts --spec",
    "test:e2e:qa": "cross-env TEST_ENV=qa wdio run ./src/config/wdio.conf.ts",
    "test:e2e:dev": "cross-env TEST_ENV=dev wdio run ./src/config/wdio.conf.ts",
    "test:e2e:staging": "cross-env TEST_ENV=staging wdio run ./src/config/wdio.conf.ts",
    "test:e2e:prod": "cross-env TEST_ENV=prod wdio run ./src/config/wdio.conf.ts",
    "test:e2e:headed:qa": "cross-env HEADLESS=false TEST_ENV=qa wdio run ./src/config/wdio.conf.ts",
    "test:e2e:headed:dev": "cross-env HEADLESS=false TEST_ENV=dev wdio run ./src/config/wdio.conf.ts",
    "test:e2e:headed:staging": "cross-env HEADLESS=false TEST_ENV=staging wdio run ./src/config/wdio.conf.ts",
    "test:e2e:headed:prod": "cross-env HEADLESS=false TEST_ENV=prod wdio run ./src/config/wdio.conf.ts",
    "test:perf": "node scripts/run-k6.js run tests/performance/sauceDemoLoad.test.js",
    "test:perf:smoke": "node scripts/run-k6.js run tests/performance/sauceDemoLoad.test.js --vus 1 --duration 5s",
    "test:perf:qa": "node scripts/run-k6.js run tests/performance/sauceDemoLoad.test.js --env=qa",
    "test:perf:dev": "node scripts/run-k6.js run tests/performance/sauceDemoLoad.test.js --env=dev",
    "test:perf:staging": "node scripts/run-k6.js run tests/performance/sauceDemoLoad.test.js --env=staging",
    "test:perf:prod": "node scripts/run-k6.js run tests/performance/sauceDemoLoad.test.js --env=prod"
  },
  "keywords": [
    "webdriverio",
    "k6",
    "typescript",
    "saucedemo",
    "e2e-testing",
    "performance-testing",
    "page-object-model"
  ],
  "author": "Antigravity Automation QA",
  "license": "ISC",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@wdio/cli": "^9.14.0",
    "@wdio/local-runner": "^9.14.0",
    "@wdio/mocha-framework": "^9.14.0",
    "@wdio/spec-reporter": "^9.14.0",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
